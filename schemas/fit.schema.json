{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "config": {},
    "data": {},
    "formatter": {},
    "checkpoint": {},
    "slurm": {
      "type": "object",
      "properties": {
        "job_type": {
          "enum": [
            "compute",
            "local",
            "local-download"
          ]
        },
        "time": {
          "type": "string"
        },
        "nodes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ntasks_per_node": {
          "type": [
            "integer",
            "null"
          ]
        },
        "gpus_per_node": {
          "type": [
            "string",
            "null"
          ]
        },
        "mem_per_cpu": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "open_mode": {
          "type": "string"
        },
        "signal": {
          "type": "string"
        },
        "requeue": {
          "type": "boolean"
        },
        "qos": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "epochs": {
      "type": "integer"
    },
    "batch_size": {
      "type": "integer"
    },
    "val_data": {},
    "test_data": {},
    "val_check_interval": {
      "type": "integer"
    },
    "configure_scheduler": {},
    "shuffle": {
      "type": "boolean"
    },
    "optimization_strategy": {},
    "model": {},
    "trainer": {},
    "device": {
      "enum": [
        "cpu",
        "cuda",
        null
      ]
    }
  },
  "additionalProperties": false
}
